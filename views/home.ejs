    <script>
       /**
 * Toggle the User Dropdown Menu
 */
function toggleDropdown() {
    const dropdown = document.getElementById('userDropdown');
    const trigger = document.getElementById('userTrigger');
    
    // Toggle classes for animation and visibility
    if (dropdown) {
        dropdown.classList.toggle('show');
    }
    
    // Rotate the burger icon for visual feedback
    if (trigger) {
        trigger.classList.toggle('active');
    }
}

/**
 * Global Event Listeners
 */
window.addEventListener('click', function(e) {
    const dropdown = document.getElementById('userDropdown');
    const trigger = document.getElementById('userTrigger');
    
    // 1. Close dropdown if clicking outside the user menu area
    if (dropdown && trigger) {
        if (!trigger.contains(e.target) && !dropdown.contains(e.target)) {
            dropdown.classList.remove('show');
            trigger.classList.remove('active');
        }
    }
});

/**
 * Handle Scroll Effects for Navigation
 */
window.addEventListener('scroll', () => {
    const nav = document.getElementById('mainNav');
    const progress = document.getElementById('progress');
    
    // Calculate scroll percentage for the top progress bar
    let winScroll = document.body.scrollTop || document.documentElement.scrollTop;
    let height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
    let scrolled = (winScroll / height) * 100;
    
    if (progress) {
        progress.style.width = scrolled + "%";
    }

    // Add 'scrolled' class to nav for glassmorphism effect
    if (nav) {
        if (window.scrollY > 50) {
            nav.classList.add('scrolled');
        } else {
            nav.classList.remove('scrolled');
        }
    }
});
    </script>
