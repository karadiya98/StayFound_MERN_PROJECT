<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Wanderlust | Seek the Unseen</title>
    
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;700&family=Playfair+Display:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet">

    <style>
        :root {
            --bg: #f8f7f4; 
            --dark: #121417; 
            --accent: #5c6351; 
            --white: #ffffff;
            --border: rgba(0, 0, 0, 0.08);
            --shadow-sm: 0 2px 8px rgba(0,0,0,0.04);
            --shadow-md: 0 12px 30px rgba(0,0,0,0.08);
            --transition: all 0.4s cubic-bezier(0.23, 1, 0.32, 1);
        }

        /* --- RESET & BASE --- */
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { 
            font-family: 'Plus Jakarta Sans', sans-serif; 
            background-color: var(--bg); 
            color: var(--dark);
            overflow-x: hidden;
            -webkit-font-smoothing: antialiased;
        }

        #progress {
            position: fixed; top: 0; left: 0; height: 3px;
            background: linear-gradient(to right, var(--accent), var(--dark));
            z-index: 5000; width: 0%;
        }

        /* --- NAVIGATION: FLOATING GLASS --- */
        nav {
            position: fixed; top: 25px; left: 50%; transform: translateX(-50%);
            width: 92%; max-width: 1100px; height: 72px;
            background: rgba(255, 255, 255, 0.7);
            backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
            z-index: 3000; display: flex; align-items: center; justify-content: space-between;
            padding: 0 24px; border-radius: 24px;
            border: 1px solid rgba(255, 255, 255, 0.5);
            box-shadow: var(--shadow-sm);
            transition: var(--transition);
        }

        nav.scrolled { 
            top: 15px; 
            height: 64px;
            width: 95%;
            background: rgba(255, 255, 255, 0.9);
            box-shadow: var(--shadow-md);
        }

        .logo { 
            font-family: 'Playfair Display', serif; 
            font-size: 1.5rem; font-weight: 700; font-style: italic;
            color: var(--dark); text-decoration: none;
            letter-spacing: -0.5px;
        }

        .nav-links { display: flex; gap: 32px; }
        .nav-links a {
            font-size: 0.85rem; font-weight: 600; color: var(--dark); 
            text-decoration: none; opacity: 0.6; transition: 0.3s;
        }
        .nav-links a:hover { opacity: 1; color: var(--accent); }

        /* --- USER DROPDOWN --- */
        .user-menu-wrapper { position: relative; }
        
        .user-trigger {
            display: flex; align-items: center; gap: 10px;
            cursor: pointer; padding: 6px 6px 6px 14px;
            background: var(--white); border-radius: 100px;
            border: 1px solid var(--border);
            transition: var(--transition);
        }
        .user-trigger:hover { border-color: var(--dark); box-shadow: var(--shadow-sm); }

        .avatar {
            width: 32px; height: 32px; background: var(--dark);
            color: var(--white); border-radius: 50%; display: grid;
            place-items: center; font-size: 0.75rem; font-weight: 700;
        }

        .user-dropdown {
            position: absolute; top: 60px; right: 0; width: 250px;
            background: var(--white); border-radius: 20px; padding: 12px;
            box-shadow: var(--shadow-md); display: none;
            flex-direction: column; z-index: 4000; border: 1px solid var(--border);
            transform-origin: top right;
        }
        .user-dropdown.show { display: flex; animation: slideIn 0.3s ease forwards; }

        @keyframes slideIn {
            from { opacity: 0; transform: translateY(10px) scale(0.98); }
            to { opacity: 1; transform: translateY(0) scale(1); }
        }

        .user-dropdown a, .logout-btn {
            padding: 12px; font-size: 0.9rem; color: var(--dark);
            text-decoration: none; border-radius: 12px; transition: 0.2s;
            display: flex; align-items: center; gap: 12px;
            border: none; background: none; width: 100%; cursor: pointer;
        }
        .user-dropdown a:hover { background: #f4f4f2; color: var(--accent); }
        .logout-btn { color: #d90429; font-weight: 600; }
        .logout-btn:hover { background: #fff1f2; }

        /* --- HERO SECTION --- */
        .hero {
            height: 100vh; display: flex; flex-direction: column;
            justify-content: center; align-items: center;
            text-align: center; padding: 0 8%;
            background: radial-gradient(circle at top right, #e9e5de 0%, var(--bg) 50%);
        }

        .hero h1 {
            font-family: 'Playfair Display', serif;
            font-size: clamp(2.8rem, 9vw, 5.8rem);
            font-weight: 400; line-height: 1.05; margin-bottom: 24px;
            letter-spacing: -1px;
        }

        .hero h1 em { font-style: italic; color: var(--accent); font-weight: 400; }

        .hero p {
            font-size: 1.15rem; max-width: 580px; opacity: 0.6;
            margin-bottom: 48px; line-height: 1.6;
        }

        /* --- MODERN BENTO SEARCH --- */
        .search-container {
            background: var(--white); padding: 10px; border-radius: 100px;
            display: flex; align-items: center;
            box-shadow: 0 20px 50px rgba(0,0,0,0.04);
            max-width: 850px; width: 100%;
            border: 1px solid var(--border);
        }

        .search-item { flex: 1; text-align: left; padding: 4px 24px; position: relative; }
        .search-item:not(:last-child)::after {
            content: ''; position: absolute; right: 0; top: 20%; height: 60%;
            width: 1px; background: var(--border);
        }
        
        .search-item label { 
            display: block; font-size: 0.65rem; font-weight: 800; 
            text-transform: uppercase; color: var(--accent); 
            letter-spacing: 1.2px; margin-bottom: 4px;
        }
        
        .search-item input { 
            border: none; outline: none; width: 100%; 
            font-family: inherit; font-size: 0.95rem; 
            background: transparent; color: var(--dark);
            font-weight: 500;
        }

        .search-go {
            background: var(--dark); color: var(--white);
            height: 54px; width: 54px; border-radius: 50%;
            display: grid; place-items: center; cursor: pointer; 
            transition: var(--transition); border: none; flex-shrink: 0;
        }
        .search-go:hover { background: var(--accent); transform: scale(1.05) rotate(90deg); }

        /* --- BUTTONS --- */
        .btn-main {
            padding: 12px 28px; background: var(--dark); color: var(--white);
            border-radius: 100px; text-decoration: none; font-size: 0.8rem;
            font-weight: 700; text-transform: uppercase; letter-spacing: 1px;
            transition: var(--transition); display: inline-block;
        }
        .btn-main:hover { transform: translateY(-2px); box-shadow: 0 8px 20px rgba(0,0,0,0.15); }

        /* --- MODAL --- */
        .modal-overlay {
            position: fixed; inset: 0; background: rgba(18, 20, 23, 0.4);
            backdrop-filter: blur(12px); display: none; align-items: center;
            justify-content: center; z-index: 9999;
        }
        .modal-card {
            background: var(--white); padding: 48px; border-radius: 32px;
            text-align: center; max-width: 440px; width: 90%;
            box-shadow: 0 40px 100px rgba(0,0,0,0.2);
        }
        .modal-card h3 { font-family: 'Playfair Display', serif; font-size: 2.2rem; margin-bottom: 12px; }
        .modal-btns { display: flex; gap: 12px; margin-top: 32px; }
        .m-btn { flex: 1; padding: 16px; border-radius: 100px; border: none; font-weight: 700; cursor: pointer; transition: 0.3s; }
        .m-logout { background: var(--dark); color: white; }
        .m-logout:hover { opacity: 0.9; }

        @media (max-width: 768px) {
            .nav-links, .search-item:not(:first-child) { display: none; }
            nav { width: 90%; padding: 0 16px; }
            .hero h1 { font-size: 3.2rem; }
            .search-container { border-radius: 24px; }
        }
    </style>
</head>
<body>

    <div id="progress"></div>

    <nav id="mainNav">
        <a href="/" class="logo">wanderlust.</a>
        
        <div class="nav-links">
            <a href="/listings">Collection</a>
            <a href="#about">Journal</a>
            <a href="/hosting">Host a Sanctuary</a>
        </div>

        <div class="nav-right">
            <% if(!currUser) { %>
                <a href="/login" style="color: var(--dark); text-decoration: none; font-size: 0.85rem; font-weight: 700; margin-right: 24px;">Sign In</a>
                <a href="/signup" class="btn-main">Get Started</a>
            <% } else { %>
                <div class="user-menu-wrapper">
                    <div class="user-trigger" onclick="toggleDropdown()">
                        <i class="fa-solid fa-bars" style="font-size: 0.8rem; opacity: 0.6;"></i>
                        <div class="avatar">
                            <%= currUser.Name.charAt(0).toUpperCase() %>
                        </div>
                    </div>

                    <div class="user-dropdown" id="userDropdown">
                        <div style="padding: 8px 12px 16px;">
                            <small style="color: var(--accent); font-weight: 800; font-size: 0.65rem; text-transform: uppercase; letter-spacing: 1px;">Member Profile</small>
                            <div style="font-family: 'Playfair Display'; font-size: 1.4rem; color: var(--dark);"><%= currUser.Name %></div>
                        </div>
                        <hr style="margin-bottom: 8px; border: none; border-top: 1px solid var(--border);">
                        <a href="/profile"><i class="fa-regular fa-compass"></i> Profile Overview</a>
                        <a href="/listings/my-accommodation"><i class="fa-solid fa-house-chimney-window"></i> My Listings</a>
                        <a href="/bookings"><i class="fa-solid fa-route"></i> My Trips</a>
                        <button class="logout-btn" onclick="openLogoutModal()">
                            <i class="fa-solid fa-arrow-right-from-bracket"></i> Sign Out
                        </button>
                    </div>
                </div>
            <% } %>
        </div>
    </nav>

    <main>
        <section class="hero">
            <p style="text-transform: uppercase; letter-spacing: 4px; font-size: 0.75rem; color: var(--accent); font-weight: 800; margin-bottom: 20px;">Redefining the Stay</p>
            <h1>Seek the <em>unseen</em>, <br> stay in the <em>extraordinary</em>.</h1>
            <p>Curated architectural gems for the thoughtful traveler. From brutalist desert escapes to organic forest retreats.</p>
            
            <form action="/search" method="GET" class="search-container">
                <div class="search-item">
                    <label>Location</label>
                    <input type="text" placeholder="Where to?">
                </div>
                <div class="search-item">
                    <label>Duration</label>
                    <input type="text" placeholder="Add dates">
                </div>
                <div class="search-item">
                    <label>Guests</label>
                    <input type="text" placeholder="Add travelers">
                </div>
                <button type="submit" class="search-go">
                    <i class="fa-solid fa-chevron-right"></i>
                </button>
            </form>
        </section>
    </main>

    <div class="modal-overlay" id="logoutModal">
        <div class="modal-card">
            <h3>Pause your journey?</h3>
            <p style="opacity: 0.6; line-height: 1.5;">Your favorite sanctuaries will be saved. We'll be ready when you are.</p>
            <div class="modal-btns">
                <button class="m-btn" style="background: #f4f4f2; color: var(--dark);" onclick="closeLogoutModal()">Keep Exploring</button>
                <form action="/logout" method="GET" style="flex: 1;">
                    <button type="submit" class="m-btn m-logout">Sign Out</button>
                </form>
            </div>
        </div>
    </div>

    <script>
        // Smooth Scroll Progress & Nav Shrink
        window.onscroll = function() {
            let winScroll = document.body.scrollTop || document.documentElement.scrollTop;
            let height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
            let scrolled = (winScroll / height) * 100;
            document.getElementById("progress").style.width = scrolled + "%";

            const nav = document.getElementById('mainNav');
            if (window.scrollY > 60) nav.classList.add('scrolled');
            else nav.classList.remove('scrolled');
        };

        // UI Logic (Preserved your function names)
        function toggleDropdown() {
            document.getElementById('userDropdown').classList.toggle('show');
        }

        function openLogoutModal() {
            document.getElementById('logoutModal').style.display = 'flex';
            document.getElementById('userDropdown').classList.remove('show');
            document.body.style.overflow = 'hidden'; // Stop body scroll
        }

        function closeLogoutModal() {
            document.getElementById('logoutModal').style.display = 'none';
            document.body.style.overflow = 'auto'; // Restore scroll
        }

        // Close UI on outside click
        window.onclick = function(event) {
            if (!event.target.closest('.user-menu-wrapper')) {
                document.getElementById('userDropdown').classList.remove('show');
            }
            if (event.target.className === 'modal-overlay') {
                closeLogoutModal();
            }
        }
    </script>
</body>
</html>