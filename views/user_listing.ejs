<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
     <title>Stayforward Rental Website</title>
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><path d=%22M50 95 C 40 85, 30 70, 30 50 C 30 30, 40 15, 50 5 L 50 25 C 60 25, 75 40, 75 60 C 75 75, 65 85, 55 90%22 fill=%22%235c7c5a%22/></svg>">
    
    
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        :root {
            --sf-green: #5c7c5a;
            --sf-green-soft: #f1f3f0;
            --sf-bg: #fdfdfd;
            --sf-text: #1a1c19;
            --radius-lg: 32px;
            --radius-md: 20px;
            --transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
        }

        body { 
            font-family: 'Plus Jakarta Sans', sans-serif; 
            background: linear-gradient(135deg, #f8f9f8 0%, #eef1ee 100%);
            color: var(--sf-text);
            min-height: 100vh;
            display: flex;
            align-items: center;
            padding: 40px 0;
        }

        .container-custom {
            max-width: 1200px;
            margin: auto;
            background: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(12px);
            border-radius: var(--radius-lg);
            overflow: hidden;
            border: 1px solid rgba(255,255,255,0.5);
            box-shadow: 0 30px 60px rgba(0,0,0,0.08);
        }

        /* --- PREVIEW SIDE --- */
        .preview-pane {
            background: linear-gradient(160deg, var(--sf-green) 0%, #3e543d 100%);
            padding: 60px;
            color: white;
            display: flex;
            flex-direction: column;
            justify-content: center;
            position: relative;
        }

        .live-card {
            background: white;
            border-radius: var(--radius-md);
            padding: 12px;
            color: var(--sf-text);
            box-shadow: 0 25px 50px rgba(0,0,0,0.2);
            transition: var(--transition);
        }

        .live-img {
            width: 100%;
            height: 240px;
            background: #eee;
            border-radius: 14px;
            object-fit: cover;
            margin-bottom: 15px;
        }

        /* --- FORM SIDE --- */
        .form-pane { padding: 60px 80px; background: white; }

        .back-link {
            display: inline-flex;
            align-items: center;
            color: var(--sf-green);
            font-weight: 700;
            font-size: 0.85rem;
            text-decoration: none;
            margin-bottom: 30px;
            transition: var(--transition);
        }
        .back-link:hover { transform: translateX(-5px); }

        .form-header h2 { font-weight: 800; font-size: 2.2rem; letter-spacing: -1px; }
        .form-header p { color: #888; margin-bottom: 40px; font-size: 0.95rem; }

        .field { margin-bottom: 24px; }
        
        .field label {
            font-size: 0.75rem;
            font-weight: 800;
            text-transform: uppercase;
            color: #aaa;
            margin-bottom: 8px;
            display: block;
            letter-spacing: 0.5px;
        }

        .field input, .field textarea {
            width: 100%;
            padding: 14px 20px;
            border: 2px solid #f1f1f1;
            border-radius: 14px;
            background: #fafafa;
            font-weight: 600;
            transition: var(--transition);
        }

        .field input:focus, .field textarea:focus {
            border-color: var(--sf-green);
            background: white;
            outline: none;
            box-shadow: 0 10px 20px rgba(92, 124, 90, 0.05);
        }

        .file-box {
            border: 2px dashed #ddd;
            border-radius: var(--radius-md);
            padding: 30px;
            text-align: center;
            cursor: pointer;
            transition: var(--transition);
            background: #fafafa;
            display: block;
        }
        .file-box:hover { border-color: var(--sf-green); background: var(--sf-green-soft); }
        .file-box input { display: none; }

        .submit-btn {
            background: var(--sf-green);
            color: white;
            border: none;
            width: 100%;
            padding: 18px;
            border-radius: 14px;
            font-weight: 800;
            font-size: 1rem;
            margin-top: 15px;
            transition: var(--transition);
            box-shadow: 0 10px 25px rgba(92, 124, 90, 0.2);
        }
        .submit-btn:hover { background: #4a6348; transform: translateY(-3px); }

        @media (max-width: 991px) {
            .preview-pane { display: none; }
            .form-pane { padding: 40px 25px; }
        }
    </style>
</head>
<body>

<div class="container">
    <div class="container-custom">
        <div class="row g-0">
            
            <div class="col-lg-5 preview-pane">
                <div class="mb-5">
                    <span class="badge bg-white text-dark rounded-pill px-3 py-2 mb-3 fw-bold">Live Preview</span>
                    <h3 class="fw-bold">Your Sanctuary's First Impression</h3>
                    <p class="opacity-75 small">This card is exactly what travelers will see. Make it count.</p>
                </div>

                <div class="live-card">
                    <img id="previewImg" src="https://images.unsplash.com/photo-1500382017468-9049fed747ef?auto=format&fit=crop&q=80&w=800" class="live-img" alt="Place Preview">
                    <div class="px-2">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <h6 id="previewTitle" class="fw-bold mb-0">The Cliffside Cabin</h6>
                            <span class="small fw-bold text-success"><i class="fa-solid fa-star"></i> New</span>
                        </div>
                        <p id="previewLoc" class="text-muted small mb-3">Himachal Pradesh, India</p>
                        <div class="d-flex justify-content-between align-items-center">
                            <div class="fw-bold">₹<span id="previewPrice">0</span> <span class="fw-normal text-muted small">/ night</span></div>
                            <div class="small text-muted"><i class="fa-regular fa-heart"></i></div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-7 form-pane">
                <a href="/listings" class="back-link">
                    <i class="fa-solid fa-arrow-left me-2"></i> Back to all listings
                </a>

                <div class="form-header">
                    <h2>Share your space</h2>
                    <p>Provide the details below to start hosting on Stayforward.</p>
                </div>

                <form action="/listings/add" method="POST" enctype="multipart/form-data">
                    
                    <div class="field">
                        <label>Listing Title</label>
                        <input type="text" name="title" id="titleInput" placeholder="e.g. Cozy Sunset Villa" required>
                    </div>

                    <div class="field">
                        <label>The Experience (Description)</label>
                        <textarea name="description" rows="3" placeholder="What makes your place unique?" required></textarea>
                    </div>

                    <div class="field">
                        <label>Cover Photo</label>
                        <label for="imageInput" class="file-box">
                            <i class="fa-solid fa-cloud-arrow-up fs-4 mb-2" style="color: var(--sf-green)"></i>
                            <p class="mb-0 small fw-bold">Click to upload photo</p>
                            <span class="text-muted extra-small">Supports JPG, PNG, WEBP</span>
                            <input type="file" name="image" id="imageInput" accept="image/*" required>
                        </label>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="field">
                                <label>Price per night (INR)</label>
                                <input type="number" name="price" id="priceInput" placeholder="2500" required>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="field">
                                <label>Country</label>
                                <input type="text" name="country" id="countryInput" placeholder="India" required>
                            </div>
                        </div>
                    </div>

                    <div class="field">
                        <label>Location (City/State)</label>
                        <input type="text" name="location" id="locationInput" placeholder="e.g. Jaipur, Rajasthan" required>
                    </div>

                    <button type="submit" class="submit-btn">Publish your Sanctuary</button>
                </form>
            </div>

        </div>
    </div>
</div>

<script>
    // Elements
    const inputs = {
        title: document.getElementById('titleInput'),
        price: document.getElementById('priceInput'),
        loc: document.getElementById('locationInput'),
        country: document.getElementById('countryInput'),
        img: document.getElementById('imageInput')
    };

    const preview = {
        title: document.getElementById('previewTitle'),
        price: document.getElementById('previewPrice'),
        loc: document.getElementById('previewLoc'),
        img: document.getElementById('previewImg')
    };

    // Live Listeners
    inputs.title.oninput = (e) => preview.title.innerText = e.target.value || 'The Cliffside Cabin';
    
    // Formatted Price (adds commas)
    inputs.price.oninput = (e) => {
        const val = e.target.value;
        preview.price.innerText = val ? Number(val).toLocaleString('en-IN') : '0';
    };

    const updateLocation = () => {
        const city = inputs.loc.value || 'Location';
        const country = inputs.country.value || 'Country';
        preview.loc.innerText = `${city}, ${country}`;
    };

    inputs.loc.oninput = updateLocation;
    inputs.country.oninput = updateLocation;

    // Image Preview
    inputs.img.onchange = function() {
        const file = this.files[0];
        if (file) {
            const reader = new FileReader();
            reader.onload = (e) => preview.img.src = e.target.result;
            reader.readAsDataURL(file);
        }
    };
</script>

</body>
</html>