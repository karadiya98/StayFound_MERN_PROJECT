<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Wanderlust Admin | Management Console</title>
    
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">

    <style>
        :root {
            --sidebar-width: 260px;
            --bg: #f0f2f5;
            --white: #ffffff;
            --dark: #1e293b;
            --primary: #4f46e5; /* Indigo */
            --accent: #0ea5e9; /* Sky Blue */
            --text-main: #334155;
            --text-muted: #64748b;
            --border: #e2e8f0;
            --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { 
            font-family: 'Plus Jakarta Sans', sans-serif; 
            background-color: var(--bg); 
            color: var(--text-main);
            display: flex;
        }

        /* --- SIDEBAR --- */
        aside {
            width: var(--sidebar-width);
            background: var(--dark);
            height: 100vh;
            position: fixed;
            padding: 30px 20px;
            color: white;
            display: flex;
            flex-direction: column;
            z-index: 100;
        }

        .admin-logo {
            font-size: 1.5rem;
            font-weight: 700;
            margin-bottom: 40px;
            display: flex;
            align-items: center;
            gap: 10px;
            color: var(--accent);
        }

        .nav-menu { list-style: none; flex-grow: 1; }
        .nav-item { margin-bottom: 8px; }
        .nav-link {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px 15px;
            color: #94a3b8;
            text-decoration: none;
            border-radius: 10px;
            transition: var(--transition);
            font-size: 0.95rem;
        }
        .nav-link:hover, .nav-link.active {
            background: rgba(255,255,255,0.1);
            color: white;
        }
        .nav-link i { width: 20px; text-align: center; }

        /* --- MAIN CONTENT --- */
        main {
            margin-left: var(--sidebar-width);
            width: calc(100% - var(--sidebar-width));
            padding: 40px;
        }

        header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 40px;
        }

        .welcome-text h1 { font-size: 1.8rem; font-weight: 700; }
        .welcome-text p { color: var(--text-muted); margin-top: 5px; }

        /* --- STAT CARDS --- */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
            gap: 25px;
            margin-bottom: 40px;
        }

        .stat-card {
            background: var(--white);
            padding: 25px;
            border-radius: 20px;
            box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);
            display: flex;
            align-items: center;
            gap: 20px;
        }

        .icon-box {
            width: 55px; height: 55px;
            border-radius: 15px;
            display: grid; place-items: center;
            font-size: 1.5rem;
        }

        .stat-info h3 { font-size: 1.5rem; font-weight: 700; }
        .stat-info p { color: var(--text-muted); font-size: 0.85rem; font-weight: 600; text-transform: uppercase; }

        /* --- DATA TABLE --- */
        .content-card {
            background: var(--white);
            border-radius: 20px;
            padding: 30px;
            box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);
        }

        .card-header {
            display: flex; justify-content: space-between;
            align-items: center; margin-bottom: 25px;
        }

        table { width: 100%; border-collapse: collapse; }
        th { 
            text-align: left; padding: 15px; 
            border-bottom: 2px solid var(--border);
            color: var(--text-muted); font-size: 0.85rem; text-transform: uppercase;
        }
        td { padding: 18px 15px; border-bottom: 1px solid var(--border); font-size: 0.95rem; }
        
        .badge {
            padding: 5px 12px; border-radius: 100px; font-size: 0.75rem; font-weight: 700;
        }
        .bg-success { background: #dcfce7; color: #166534; }
        .bg-pending { background: #fef9c3; color: #854d0e; }

        .action-btn {
            background: none; border: none; cursor: pointer;
            color: var(--text-muted); transition: 0.2s; font-size: 1rem;
            margin-left: 10px;
        }
        .action-btn:hover { color: var(--primary); }
        .delete-btn:hover { color: #ef4444; }

        @media (max-width: 1024px) {
            aside { width: 80px; padding: 20px 10px; }
            .admin-logo span, .nav-link span { display: none; }
            main { margin-left: 80px; width: calc(100% - 80px); }
        }
    </style>
</head>
<body>

    <aside>
        <div class="admin-logo">
            <i class="fa-solid fa-earth-americas"></i>
            <span>Wanderlust.</span>
        </div>

        <ul class="nav-menu">
            <li class="nav-item">
                <a href="#" class="nav-link active">
                    <i class="fa-solid fa-chart-pie"></i>
                    <span>Dashboard</span>
                </a>
            </li>
            <li class="nav-item">
                <a href="#" class="nav-link">
                    <i class="fa-solid fa-hotel"></i>
                    <span>Listings</span>
                </a>
            </li>
            <li class="nav-item">
                <a href="#" class="nav-link">
                    <i class="fa-solid fa-users"></i>
                    <span>Users</span>
                </a>
            </li>
            <li class="nav-item">
                <a href="#" class="nav-link">
                    <i class="fa-solid fa-calendar-check"></i>
                    <span>Bookings</span>
                </a>
            </li>
        </ul>

        <div class="sidebar-footer">
            <a href="/" class="nav-link">
                <i class="fa-solid fa-arrow-left"></i>
                <span>View Website</span>
            </a>
        </div>
    </aside>

    <main>
        <header>
            <div class="welcome-text">
                <h1>Dashboard Overview</h1>
                <p>Monitor your sanctuaries and user activity.</p>
            </div>
            <div class="user-profile">
                <button class="action-btn" style="font-weight: 600;">Admin User <i class="fa-solid fa-chevron-down"></i></button>
            </div>
        </header>

        <section class="stats-grid">
            <div class="stat-card">
                <div class="icon-box" style="background: #e0e7ff; color: #4338ca;">
                    <i class="fa-solid fa-house"></i>
                </div>
                <div class="stat-info">
                    <p>Total Listings</p>
                    <h3>128</h3> </div>
            </div>
            <div class="stat-card">
                <div class="icon-box" style="background: #dcfce7; color: #15803d;">
                    <i class="fa-solid fa-dollar-sign"></i>
                </div>
                <div class="stat-info">
                    <p>Total Revenue</p>
                    <h3>$14,200</h3> </div>
            </div>
            <div class="stat-card">
                <div class="icon-box" style="background: #ffedd5; color: #9a3412;">
                    <i class="fa-solid fa-user-plus"></i>
                </div>
                <div class="stat-info">
                    <p>New Users</p>
                    <h3>42</h3>
                </div>
            </div>
        </section>

        <section class="content-card">
            <div class="card-header">
                <h2>Recent Listings</h2>
                <a href="/listings/new" style="color: var(--primary); text-decoration: none; font-weight: 600; font-size: 0.9rem;">+ Add New</a>
            </div>
            
            <table>
                <thead>
                    <tr>
                        <th>Listing Name</th>
                        <th>Location</th>
                        <th>Price</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td style="font-weight: 600;">Rustic Cabin Escape</td>
                        <td>Oregon, USA</td>
                        <td>$120/night</td>
                        <td><span class="badge bg-success">Active</span></td>
                        <td>
                            <button class="action-btn"><i class="fa-regular fa-pen-to-square"></i></button>
                            <button class="action-btn delete-btn"><i class="fa-regular fa-trash-can"></i></button>
                        </td>
                    </tr>
                    <tr>
                        <td style="font-weight: 600;">Modern Glass Villa</td>
                        <td>Bali, Indonesia</td>
                        <td>$450/night</td>
                        <td><span class="badge bg-pending">Pending</span></td>
                        <td>
                            <button class="action-btn"><i class="fa-regular fa-pen-to-square"></i></button>
                            <button class="action-btn delete-btn"><i class="fa-regular fa-trash-can"></i></button>
                        </td>
                    </tr>
                </tbody>
            </table>
        </section>
    </main>

</body>
</html>