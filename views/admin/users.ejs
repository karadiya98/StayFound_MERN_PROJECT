<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
     <title>Stayforward admin panel</title>
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><path d=%22M50 95 C 40 85, 30 70, 30 50 C 30 30, 40 15, 50 5 L 50 25 C 60 25, 75 40, 75 60 C 75 75, 65 85, 55 90%22 fill=%22%235c7c5a%22/></svg>">
    
    
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <style>
        :root {
            --sidebar-width: 280px;
            --bg: #f3f4f6;
            --white: #ffffff;
            --dark: #0f172a;
            --primary: #1e3a8a; 
            --accent: #d8cb57;
            --border: #e5e7eb;
            --text-main: #1f2937;
            --text-muted: #6b7280;
            --success-bg: #dcfce7;
            --success-text: #166534;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { 
            font-family: 'Plus Jakarta Sans', sans-serif; 
            background-color: var(--bg); 
            color: var(--text-main);
            display: flex;
            min-height: 100vh;
        }

        /* --- MODERN SIDEBAR --- */
        aside {
            width: var(--sidebar-width);
            background: var(--dark);
            height: 100vh;
            position: fixed;
            padding: 24px;
            display: flex;
            flex-direction: column;
            color: #fff;
            z-index: 100;
        }

        .brand {
            display: flex;
            align-items: center; gap: 12px;
            padding: 12px; margin-bottom: 32px;
        }

        .brand-logo {
            background: var(--primary);
            width: 35px; height: 35px;
            display: flex; align-items: center; justify-content: center;
            border-radius: 8px; color: var(--accent);
        }

        .brand span { font-weight: 800; font-size: 1.1rem; letter-spacing: -0.5px; }

        .nav-section { margin-bottom: 24px; }
        .nav-label {
            font-size: 0.7rem; text-transform: uppercase; letter-spacing: 1px;
            color: #475569; margin-bottom: 12px; padding-left: 12px; font-weight: 700;
        }

        .nav-link {
            display: flex; align-items: center; gap: 12px; padding: 12px 16px;
            color: #94a3b8; text-decoration: none; border-radius: 10px;
            transition: all 0.2s; font-size: 0.9rem; font-weight: 500; margin-bottom: 4px;
        }

        .nav-link:hover { background: rgba(255,255,255,0.05); color: #fff; }
        .nav-link.active { background: var(--primary); color: white; }

        /* --- MAIN CONTENT AREA --- */
        main {
            margin-left: var(--sidebar-width);
            width: calc(100% - var(--sidebar-width));
            padding: 32px 40px;
        }

        .header-flex {
            display: flex; justify-content: space-between; align-items: flex-start;
            margin-bottom: 32px;
        }

        .controls-row { display: flex; gap: 16px; margin-bottom: 24px; }

        .search-wrapper { position: relative; flex: 1; }
        .search-wrapper i {
            position: absolute; left: 16px; top: 50%; transform: translateY(-50%);
            color: var(--text-muted);
        }

        .search-input {
            width: 100%; padding: 12px 12px 12px 48px;
            border-radius: 12px; border: 1px solid var(--border);
            outline: none; font-family: inherit; font-size: 0.9rem;
        }

        /* --- CARDS & TABLES --- */
        .card {
            background: var(--white); border-radius: 16px;
            border: 1px solid var(--border); overflow: hidden;
            box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);
        }

        .stats-card { flex: 1; padding: 20px; display: flex; align-items: center; gap: 15px; }

        table { width: 100%; border-collapse: collapse; text-align: left; }
        th { 
            padding: 16px 24px; background: #f9fafb; border-bottom: 1px solid var(--border);
            font-size: 0.75rem; text-transform: uppercase; color: var(--text-muted); font-weight: 700;
        }
        td { padding: 16px 24px; border-bottom: 1px solid var(--border); vertical-align: middle; }

        .user-avatar {
            width: 40px; height: 40px; border-radius: 10px; 
            background: #e2e8f0; display: flex; align-items: center; 
            justify-content: center; font-weight: 700; color: var(--primary);
        }

        .prop-info-title { font-weight: 700; color: var(--dark); display: block; }
        .prop-info-meta { font-size: 0.75rem; color: var(--text-muted); }

        .action-group { display: flex; gap: 8px; justify-content: flex-end; }
        .btn-icon {
            width: 36px; height: 36px; display: flex; align-items: center; justify-content: center;
            border-radius: 8px; border: 1px solid var(--border); background: #fff;
            color: var(--text-main); cursor: pointer; transition: 0.2s;
        }
        .btn-icon:hover { background: #f9fafb; border-color: var(--primary); color: var(--primary); }
        .btn-icon.delete:hover { border-color: #fca5a5; color: #ef4444; }

        .btn-primary {
            background: var(--primary); color: white; padding: 12px 20px;
            border-radius: 10px; font-weight: 600; border: none; cursor: pointer;
            display: flex; align-items: center; gap: 8px;
        }
    </style>
</head>
<body>

    <aside>
        <div class="brand">
            <div class="brand-logo"><i class="fa-solid fa-bolt"></i></div>
            <span>Stayforward</span>
        </div>

        <div class="nav-section">
            <p class="nav-label">General</p>
            <nav>
                <a href="/admin" class="nav-link"><i class="fa-solid fa-table-columns"></i><span>Dashboard</span></a>
                <a href="/admin/listings" class="nav-link"><i class="fa-solid fa-layer-group"></i><span>Inventory</span></a>
            </nav>
        </div>

        <div class="nav-section">
            <p class="nav-label">Management</p>
            <nav>
                <a href="/admin/users" class="nav-link active"><i class="fa-solid fa-user-group"></i><span>Users</span></a>
                <a href="#" class="nav-link"><i class="fa-solid fa-calendar-check"></i><span>Bookings</span></a>
            </nav>
        </div>

        <a href="/" class="nav-link" style="margin-top: auto;">
            <i class="fa-solid fa-arrow-right-from-bracket"></i>
            <span>View Website</span>
        </a>
    </aside>

    <main>
        <header class="header-flex">
            <div>
                <h1 style="font-size: 1.8rem; font-weight: 800; letter-spacing: -0.5px;">User Directory</h1>
                <p style="color: var(--text-muted); font-size: 0.9rem;">Management of all users registered in your database.</p>
            </div>
            <button class="btn-primary">
                <i class="fa-solid fa-user-plus"></i> Add User
            </button>
        </header>

        <div class="controls-row" style="margin-bottom: 32px;">
            <div class="card stats-card">
                <div style="background: #eff6ff; color: var(--primary); padding: 12px; border-radius: 12px;">
                    <i class="fa-solid fa-users fa-lg"></i>
                </div>
                <div>
                    <span class="prop-info-meta">Total Profiles</span>
                    <h3 style="font-size: 1.4rem;"><%= allusers.length %></h3>
                </div>
            </div>
            <div class="card stats-card">
                <div style="background: #fef9c3; color: #854d0e; padding: 12px; border-radius: 12px;">
                    <i class="fa-solid fa-shield-halved fa-lg"></i>
                </div>

                <div>
                    <span class="prop-info-meta">User Listings</span>
                    <h3 style="font-size: 1.4rem;"><%= alllistings.length %></h3>
                </div>
                
            </div>
        </div>

        <div class="controls-row">
            <div class="search-wrapper">
                <i class="fa-solid fa-magnifying-glass"></i>
                <input type="text" id="userSearch" class="search-input" placeholder="Search by name, phone or location...">
            </div>
        </div>

        <div class="card">
            <table id="userTable">
                <thead>
                    <tr>
                        <th>User & Phone</th>
                        <th>Address</th>
                        <th>Location</th>
                        <th style="text-align: right;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% if(allusers && allusers.length > 0) { %>
                        <% allusers.forEach(user => { %>
                            <tr>
                                <td>
                                    <div style="display: flex; align-items: center; gap: 12px;">
                                        <div class="user-avatar">
                                            <%= user.Name ? user.Name.charAt(0).toUpperCase() : 'U' %>
                                        </div>
                                        <div>
                                            <span class="prop-info-title"><%= user.Name %></span>
                                            <span class="prop-info-meta"><i class="fa-solid fa-phone" style="font-size: 10px;"></i> <%= user.PhoneNumber %></span>
                                        </div>
                                    </div>
                                </td>
                                <td style="max-width: 250px;">
                                    <span style="font-size: 0.85rem; color: var(--text-main);"><%= user.Address %></span>
                                </td>
                                <td>
                                    <div>
                                        <span class="prop-info-title" style="font-size: 0.85rem;"><%= user.location %></span>
                                        <span class="prop-info-meta"><%= user.country %></span>
                                    </div>
                                </td>
                                <td>
                                    <div class="action-group">
                                        <button class="btn-icon" title="View Details"><i class="fa-solid fa-eye"></i></button>
                                        <button class="btn-icon delete" title="Remove"><i class="fa-solid fa-trash"></i></button>
                                    </div>
                                </td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="4" style="padding: 60px; text-align: center;">
                                <p style="color: var(--text-muted);">No users found in the database.</p>
                            </td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </main>

    <script>
        document.getElementById('userSearch').addEventListener('keyup', function() {
            let filter = this.value.toLowerCase();
            let rows = document.querySelectorAll('#userTable tbody tr');
            rows.forEach(row => {
                row.style.display = row.textContent.toLowerCase().includes(filter) ? '' : 'none';
            });
        });
    </script>
</body>
</html>