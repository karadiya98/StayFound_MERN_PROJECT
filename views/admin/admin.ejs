<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Velo Admin | Stayforward Management</title>
    
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <style>
        :root {
            --sidebar-width: 280px;
            --bg: #f3f4f6;
            --white: #ffffff;
            --dark: #0f172a;
            --primary: #1e3a8a; 
            --accent: #d8cb57;
            --border: #e5e7eb;
            --text-main: #1f2937;
            --text-muted: #6b7280;
            --success-bg: #dcfce7;
            --success-text: #166534;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { 
            font-family: 'Plus Jakarta Sans', sans-serif; 
            background-color: var(--bg); 
            color: var(--text-main);
            display: flex;
        }

        /* --- MODERN SIDEBAR --- */
        aside {
            width: var(--sidebar-width);
            background: var(--dark);
            height: 100vh;
            position: fixed;
            padding: 24px;
            display: flex;
            flex-direction: column;
            color: #fff;
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px;
            margin-bottom: 32px;
        }

        .brand-logo {
            background: var(--primary);
            width: 35px;
            height: 35px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 8px;
            color: var(--accent);
        }

        .brand span { font-weight: 800; font-size: 1.1rem; letter-spacing: -0.5px; }

        .nav-section { margin-bottom: 24px; }
        .nav-label {
            font-size: 0.7rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: #475569;
            margin-bottom: 12px;
            padding-left: 12px;
            font-weight: 700;
        }

        .nav-link {
            display: flex; align-items: center; gap: 12px; padding: 12px 16px;
            color: #94a3b8; text-decoration: none; border-radius: 10px;
            transition: all 0.2s; font-size: 0.9rem; font-weight: 500;
            margin-bottom: 4px;
        }

        .nav-link:hover { background: rgba(255,255,255,0.05); color: #fff; }
        .nav-link.active { background: var(--primary); color: white; }

        /* --- MAIN CONTENT AREA --- */
        main {
            margin-left: var(--sidebar-width);
            width: calc(100% - var(--sidebar-width));
            padding: 32px 40px;
        }

        .header-flex {
            display: flex; justify-content: space-between; align-items: flex-start;
            margin-bottom: 32px;
        }

        /* --- SEARCH & FILTERS --- */
        .controls-row {
            display: flex; gap: 16px; margin-bottom: 24px;
        }

        .search-wrapper {
            position: relative; flex: 1;
        }

        .search-wrapper i {
            position: absolute; left: 16px; top: 50%; transform: translateY(-50%);
            color: var(--text-muted);
        }

        .search-input {
            width: 100%; padding: 12px 12px 12px 48px;
            border-radius: 12px; border: 1px solid var(--border);
            outline: none; font-family: inherit; font-size: 0.9rem;
        }

        /* --- TABLE UPGRADE --- */
        .card {
            background: var(--white); border-radius: 16px;
            border: 1px solid var(--border); overflow: hidden;
            box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);
        }

        .status-badge {
            padding: 4px 10px; border-radius: 20px; font-size: 0.75rem;
            font-weight: 700; background: var(--success-bg); color: var(--success-text);
        }

        .btn-primary {
            background: var(--primary); color: white; padding: 12px 20px;
            border-radius: 10px; font-weight: 600; font-size: 0.85rem;
            border: none; cursor: pointer; display: flex; align-items: center; gap: 8px;
            transition: opacity 0.2s;
        }

        .prop-info-title { font-weight: 700; color: var(--dark); display: block; }
        .prop-info-meta { font-size: 0.75rem; color: var(--text-muted); }

        .action-group { display: flex; gap: 8px; justify-content: flex-end; }
        .btn-icon {
            width: 36px; height: 36px; display: flex; align-items: center; justify-content: center;
            border-radius: 8px; border: 1px solid var(--border); background: #fff;
            color: var(--text-main); cursor: pointer; transition: 0.2s;
        }
        .btn-icon:hover { background: #f9fafb; border-color: var(--primary); color: var(--primary); }
        .btn-icon.delete:hover { border-color: #fca5a5; color: #ef4444; }

    </style>
</head>
<body>

    <aside>
        <div class="brand">
            <div class="brand-logo"><i class="fa-solid fa-bolt"></i></div>
            <span>Stayforward</span>
        </div>

        <div class="nav-section">
            <p class="nav-label">General</p>
            <nav>
                <a href="/admin" class="nav-link active">
                    <i class="fa-solid fa-grid-2"></i>
                    <span>Dashboard</span>
                </a>
                <a href="/admin/listings" class="nav-link">
                    <i class="fa-solid fa-layer-group"></i>
                    <span>Inventory</span>
                </a>
            </nav>
        </div>

        <div class="nav-section">
            <p class="nav-label">Management</p>
            <nav>
                <a href="/admin/users" class="nav-link"><i class="fa-solid fa-user-group"></i><span>Users</span></a>
                <a href="#" class="nav-link"><i class="fa-solid fa-calendar-check"></i><span>Bookings</span></a>
                <a href="#" class="nav-link"><i class="fa-solid fa-wallet"></i><span>Payouts</span></a>
            </nav>
        </div>

        <a href="/" class="nav-link" style="margin-top: auto;">
            <i class="fa-solid fa-arrow-right-from-bracket"></i>
            <span>View Website</span>
        </a>
    </aside>

    <main>
        <div class="header-flex">
            <div>
                <h1 style="font-size: 1.5rem; font-weight: 800;">Property Inventory</h1>
                <p style="color: var(--text-muted); font-size: 0.9rem;">Manage and track your sanctuary listings.</p>
            </div>
            <a href="/listings/add" class="btn-primary">
                <i class="fa-solid fa-plus"></i> Add New Property
            </a>
        </div>

        <div class="controls-row">
            <div class="search-wrapper">
                <i class="fa-solid fa-magnifying-glass"></i>
                <input type="text" class="search-input" placeholder="Search by name, UID, or location...">
            </div>
            <button class="btn-icon" title="Filter"><i class="fa-solid fa-filter"></i></button>
            <button class="btn-icon" title="Export"><i class="fa-solid fa-download"></i></button>
        </div>

        <div class="card">
            <table>
                <thead>
                    <tr>
                        <th style="padding: 16px 24px; text-align: left; font-size: 0.75rem; color: var(--text-muted);">PROPERTY</th>
                        <th style="text-align: left; font-size: 0.75rem; color: var(--text-muted);">LOCATION</th>
                        <th style="text-align: left; font-size: 0.75rem; color: var(--text-muted);">STATUS</th>
                        <th style="text-align: left; font-size: 0.75rem; color: var(--text-muted);">PRICE</th>
                        <th style="text-align: right; padding-right: 24px; font-size: 0.75rem; color: var(--text-muted);">ACTIONS</th>
                    </tr>
                </thead>
                
                <tbody>
                    <% for(let listing of allListings) { %>
                    <tr>
                        <td style="padding: 16px 24px;">
                            <div style="display: flex; align-items: center; gap: 12px;">
                                <img src="<%= listing.image.url %>" style="width: 40px; height: 40px; border-radius: 8px; object-fit: cover;">
                                <div>
                                    <span class="prop-info-title"><%= listing.title %></span>
                                    <span class="prop-info-meta">ID: #<%= listing._id.toString().slice(-6).toUpperCase() %></span>
                                </div>
                            </div>
                        </td>
                        <td>
                            <span style="font-size: 0.85rem; font-weight: 500;"><%= listing.location %></span><br>
                            <span style="font-size: 0.75rem; color: var(--text-muted);"><%= listing.country %></span>
                        </td>
                        <td><span class="status-badge">Active</span></td>
                        <td><span style="font-weight: 700;">₹<%= listing.price.toLocaleString("en-IN") %></span></td>
                        <td style="padding-right: 24px;">
                            <div class="action-group">
                                <a href="/listings/<%= listing._id %>/edit" class="btn-icon"><i class="fa-solid fa-pen"></i></a>
                                <form action="/listings/<%= listing._id %>?_method=DELETE" method="POST" style="display:inline;">
                                    <button class="btn-icon delete"><i class="fa-solid fa-trash"></i></button>
                                </form>
                            </div>
                        </td>
                    </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </main>

</body>
</html>